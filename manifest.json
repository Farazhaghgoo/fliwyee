{
  "manifest_version": 3,
  "name": "Fliwyee",
  "short_name": "Fliwyee",
  "version": "0.3.0",
  "description": "Learning Italian with YouTube, easier: save words and sentences from the subtitles and ask your AI chat about them.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fliwyee",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "downloads", "downloads.open", "sidePanel", "clipboardWrite", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Pause / resume capture (the session keeps going)"
    },
    "end-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "End the session and save its file"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/format.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ]
}
